{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storyforge.local/manifest.schema.json",
  "title": "StoryForge renderer manifest v1",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "title",
    "demo",
    "format",
    "style_id",
    "characters",
    "assets",
    "scenes",
    "narration",
    "music",
    "captions"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "demo": {
      "type": "boolean"
    },
    "format": {
      "type": "object",
      "required": [
        "width",
        "height",
        "fps"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 320,
          "maximum": 3840,
          "multipleOf": 2
        },
        "height": {
          "type": "integer",
          "minimum": 320,
          "maximum": 3840,
          "multipleOf": 2
        },
        "fps": {
          "type": "integer",
          "minimum": 24,
          "maximum": 60
        }
      },
      "additionalProperties": false
    },
    "style_id": {
      "enum": [
        "midnight-dossier",
        "coastal-archive",
        "ember-noir"
      ]
    },
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "coat",
          "skin",
          "trousers",
          "scale"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "coat": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "skin": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "trousers": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "scale": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 2
          }
        },
        "additionalProperties": false
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "src"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "image",
              "audio"
            ]
          },
          "src": {
            "type": "string",
            "minLength": 1,
            "description": "Relative to public/. No traversal, absolute paths, URLs, query/fragment, or symlinks outside public/."
          },
          "provenance": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": [
          "id",
          "template",
          "duration_in_frames",
          "eyebrow",
          "headline",
          "body",
          "camera",
          "seed"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "template": {
            "enum": [
              "lighthouse-coast",
              "archive-room",
              "signal-chamber",
              "forest-path"
            ]
          },
          "duration_in_frames": {
            "type": "integer",
            "minimum": 2
          },
          "eyebrow": {
            "type": "string"
          },
          "headline": {
            "type": "string",
            "maxLength": 100
          },
          "body": {
            "type": "string",
            "maxLength": 240
          },
          "character_id": {
            "type": "string",
            "minLength": 1
          },
          "camera": {
            "enum": [
              "wide",
              "medium",
              "detail"
            ]
          },
          "seed": {
            "type": "integer"
          },
          "image_asset_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "narration": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "asset_id",
            "duration_seconds",
            "measured"
          ],
          "properties": {
            "asset_id": {
              "type": "string",
              "minLength": 1
            },
            "duration_seconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "measured": {
              "const": true
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "music": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "asset_id",
            "volume"
          ],
          "properties": {
            "asset_id": {
              "type": "string",
              "minLength": 1
            },
            "volume": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.5
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "captions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text",
          "start",
          "end"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "demo": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "narration": {
            "type": "object"
          },
          "captions": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "description": "Structural schema. src/validate.mjs additionally checks unique IDs, referenced asset types, safe local paths, ordered caption times, captions bounded by measured narration, and positive narration duration <= timeline+0.05 seconds. Node scripts probe the actual narration with ffprobe."
}
