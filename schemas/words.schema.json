{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "text",
      "start",
      "end"
    ],
    "properties": {
      "text": {
        "type": "string",
        "minLength": 1
      },
      "start": {
        "type": "number",
        "minimum": 0
      },
      "end": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    },
    "additionalProperties": true
  }
}
