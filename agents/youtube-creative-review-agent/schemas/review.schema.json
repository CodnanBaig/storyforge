{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:unquiet-index:creative-review:report:1.0",
  "title": "Creative review report",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviewed_at": {
      "type": "string",
      "minLength": 1
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "enum": [
        "APPROVE",
        "REVISE",
        "REJECT",
        "BLOCKED"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "research": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "recent_trend",
            "evergreen"
          ]
        },
        "completed": {
          "type": "boolean"
        },
        "queries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "query": {
                "type": "string",
                "minLength": 1
              },
              "searched_at": {
                "type": "string",
                "minLength": 1
              },
              "notes": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "query",
              "searched_at",
              "notes"
            ],
            "additionalProperties": false
          }
        },
        "comparables": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{11}$"
              },
              "url": {
                "type": "string",
                "minLength": 1
              },
              "channel_id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "published_at": {
                "type": "string",
                "minLength": 1
              },
              "observed_at": {
                "type": "string",
                "minLength": 1
              },
              "duration_seconds": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "public_views": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "language": {
                "type": "string",
                "minLength": 1
              },
              "format_match": {
                "type": "boolean"
              },
              "selection": {
                "enum": [
                  "recent_ordinary",
                  "breakout_candidate"
                ]
              },
              "inspection": {
                "enum": [
                  "metadata",
                  "transcript",
                  "video"
                ]
              },
              "evidence_url": {
                "type": "string",
                "minLength": 1
              },
              "relevance": {
                "type": "string",
                "minLength": 1
              },
              "limits": {
                "type": "string",
                "minLength": 1
              }
